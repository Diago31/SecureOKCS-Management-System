@model SecureOKCS.ViewModels.FaceEnrollmentViewModel

@{
    ViewData["Title"] = "Face ID Enrollment";

    bool isEnrolled =
        ViewBag.FaceEnrolled is bool enrolled &&
        enrolled;

    string fullName =
        ViewBag.FullName as string ??
        User.Identity?.Name ??
        "User";
}

<style>
    .face-page {
        max-width: 1150px;
        margin: 0 auto;
    }

    .face-header {
        background: linear-gradient( 135deg, #111827, #1f2937);
        color: white;
        border-radius: 22px;
    }

    .security-badge {
        background: rgba(255, 255, 255, 0.12);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 50px;
        padding: 8px 16px;
    }

    .camera-card,
    .instruction-card {
        border-radius: 20px;
        overflow: hidden;
    }

    .camera-stage {
        position: relative;
        width: 100%;
        aspect-ratio: 4 / 3;
        overflow: hidden;
        background: #05070a;
        border-radius: 16px;
    }

        .camera-stage video,
        .camera-stage canvas {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transform: scaleX(-1);
        }

        .camera-stage canvas {
            pointer-events: none;
        }

    .face-guide {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 44%;
        height: 68%;
        transform: translate(-50%, -50%);
        border: 3px solid rgba(255, 255, 255, 0.85);
        border-radius: 48%;
        box-shadow: 0 0 0 999px rgba(0, 0, 0, 0.28);
        pointer-events: none;
    }

    .camera-message {
        position: absolute;
        left: 50%;
        bottom: 20px;
        transform: translateX(-50%);
        width: calc(100% - 40px);
        padding: 11px 16px;
        color: white;
        background: rgba(0, 0, 0, 0.72);
        border-radius: 12px;
        text-align: center;
        font-weight: 600;
        backdrop-filter: blur(6px);
    }

    .camera-loading {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        color: white;
        background: rgba(5, 7, 10, 0.92);
        z-index: 10;
    }

        .camera-loading.d-none {
            display: none !important;
        }

    .check-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 13px 14px;
        background: #f8f9fa;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        margin-bottom: 10px;
    }

    .check-indicator {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        flex: 0 0 28px;
        width: 28px;
        height: 28px;
        color: #6b7280;
        background: #e5e7eb;
        border-radius: 50%;
        font-size: 13px;
        font-weight: 700;
    }

    .check-item.passed {
        color: #166534;
        background: #f0fdf4;
        border-color: #86efac;
    }

        .check-item.passed .check-indicator {
            color: white;
            background: #16a34a;
        }

    .scan-status {
        border-radius: 50px;
        padding: 8px 16px;
        font-weight: 600;
    }

    .privacy-box {
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        border-radius: 14px;
    }

    .progress {
        height: 10px;
        border-radius: 50px;
    }

    .progress-bar {
        transition: width 0.3s ease;
    }

    @@media (max-width: 767.98px) {
        .face-header {
            border-radius: 16px;
        }

        .face-guide {
            width: 52%;
            height: 66%;
        }
    }
</style>

<div class="face-page">

    <div class="face-header shadow-sm p-4 p-md-5 mb-4">

        <div class="d-md-flex
            justify-content-between
            align-items-center">

            <div>

                <p class="text-info fw-semibold mb-2">
                    BIOMETRIC SECURITY
                </p>

                <h1 class="fw-bold mb-2">
                    Face ID Enrollment
                </h1>

                <p class="text-light mb-0">
                    Register a secure facial profile for
                    @fullName.
                </p>

            </div>

            <div class="mt-3 mt-md-0">

                <span class="security-badge">

                    @if (isEnrolled)
                    {
                        <span>
                            Status: Enrolled
                        </span>
                    }
                    else
                    {
                        <span>
                            Status: Not Enrolled
                        </span>
                    }

                </span>

            </div>

        </div>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success
            alert-dismissible fade show">

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (isEnrolled)
    {
        <div class="alert alert-info">

            <strong>Face ID is active.</strong>
            Scanning again will securely replace your
            existing facial profile.

        </div>
    }

    <form asp-controller="Face"
          asp-action="Enroll"
          method="post"
          id="faceEnrollmentForm">

        @Html.AntiForgeryToken()

        <input asp-for="DescriptorJson"
               type="hidden"
               id="DescriptorJson" />

        <input asp-for="LivenessScore"
               type="hidden"
               id="LivenessScore" />

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>

        <div class="row g-4">

            <!-- CAMERA SECTION -->
            <div class="col-lg-7">

                <div class="card border-0 shadow-sm
                    camera-card h-100">

                    <div class="card-body p-3 p-md-4">

                        <div class="d-flex
                            justify-content-between
                            align-items-center mb-3">

                            <div>

                                <h4 class="fw-bold mb-1">
                                    Live Camera
                                </h4>

                                <small class="text-muted">
                                    Only one person should appear.
                                </small>

                            </div>

                            <span id="scanStatus"
                                  class="badge bg-secondary
                                scan-status">

                                Camera Off

                            </span>

                        </div>

                        <div class="camera-stage">

                            <video id="faceVideo"
                                   autoplay
                                   muted
                                   playsinline>
                            </video>

                            <canvas id="faceCanvas">
                            </canvas>

                            <div class="face-guide"></div>

                            <div id="cameraLoading"
                                 class="camera-loading d-none">

                                <div class="spinner-border
                                    text-info mb-3">
                                </div>

                                <strong id="loadingMessage">
                                    Loading face models...
                                </strong>

                            </div>

                            <div id="cameraMessage"
                                 class="camera-message">

                                Press Start Camera to begin.

                            </div>

                        </div>

                        <div class="mt-4">

                            <div class="d-flex
                                justify-content-between mb-2">

                                <small class="fw-semibold">
                                    Enrollment progress
                                </small>

                                <small id="progressText">
                                    0%
                                </small>

                            </div>

                            <div class="progress">

                                <div id="scanProgress"
                                     class="progress-bar
                                    bg-info"
                                     role="progressbar"
                                     style="width: 0%"
                                     aria-valuemin="0"
                                     aria-valuemax="100"
                                     aria-valuenow="0">
                                </div>

                            </div>

                        </div>

                        <div class="d-flex
                            flex-wrap gap-2 mt-4">

                            <button type="button"
                                    id="startCameraButton"
                                    class="btn btn-primary">

                                Start Camera

                            </button>

                            <button type="button"
                                    id="retryButton"
                                    class="btn
                                btn-outline-secondary"
                                    hidden>

                                Scan Again

                            </button>

                            <a asp-controller="Dashboard"
                               asp-action="Index"
                               class="btn btn-secondary">

                                Back

                            </a>

                        </div>

                    </div>

                </div>

            </div>

            <!-- VALIDATION SECTION -->
            <div class="col-lg-5">

                <div class="card border-0 shadow-sm
                    instruction-card">

                    <div class="card-body p-4">

                        <h4 class="fw-bold mb-1">
                            Security Check
                        </h4>

                        <p class="text-muted mb-4">
                            Complete every check before saving.
                        </p>

                        <div id="checkFaceCount"
                             class="check-item">

                            <span class="check-indicator">
                                1
                            </span>

                            <span>
                                One face detected
                            </span>

                        </div>

                        <div id="checkPosition"
                             class="check-item">

                            <span class="check-indicator">
                                2
                            </span>

                            <span>
                                Face centred and clearly visible
                            </span>

                        </div>

                        <div id="checkQuality"
                             class="check-item">

                            <span class="check-indicator">
                                3
                            </span>

                            <span>
                                Image quality is sufficient
                            </span>

                        </div>

                        <div id="checkBlink"
                             class="check-item">

                            <span class="check-indicator">
                                4
                            </span>

                            <span>
                                Natural blink detected
                            </span>

                        </div>

                        <div id="checkLiveness"
                             class="check-item">

                            <span class="check-indicator">
                                5
                            </span>

                            <span>
                                Liveness and anti-spoof passed
                            </span>

                        </div>

                        <div class="privacy-box p-3 mt-4">

                            <strong>
                                Biometric privacy
                            </strong>

                            <p class="small mb-0 mt-1">

                                SecureOKCS does not store your
                                photograph or camera recording.
                                Only an encrypted mathematical
                                facial descriptor is saved.

                            </p>

                        </div>

                        <div class="form-check mt-4">

                            <input asp-for="ConsentGiven"
                                   class="form-check-input"
                                   id="ConsentGiven" />

                            <label asp-for="ConsentGiven"
                                   class="form-check-label">

                                I consent to the processing of
                                my biometric face descriptor
                                for authentication.

                            </label>

                        </div>

                        <span asp-validation-for="ConsentGiven"
                              class="text-danger small">
                        </span>

                        <span asp-validation-for="DescriptorJson"
                              class="text-danger small d-block">
                        </span>

                        <button type="submit"
                                id="saveFaceButton"
                                class="btn btn-success
                            w-100 mt-4"
                                disabled>

                            Save Face ID

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </form>

</div>

<script type="module"
        src="~/js/face-enrollment.js"
        asp-append-version="true">
</script>