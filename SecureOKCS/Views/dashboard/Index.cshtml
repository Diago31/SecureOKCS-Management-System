@{
    ViewData["Title"] = "Dashboard";

    string fullName =
        ViewBag.FullName ??
        User.Identity?.Name ??
        "User";

    string role =
        ViewBag.Role ?? "Unknown";

    int intrusionCount =
        ViewBag.IntrusionCount is int count
            ? count
            : 0;

    var intrusionAlerts =
        ViewBag.IntrusionAlerts as
            List<SecureOKCS.Models.AuditLog>
        ?? new List<SecureOKCS.Models.AuditLog>();

    var latestBlockedAttempt =
        ViewBag.LatestBlockedAttempt as
            SecureOKCS.Models.AuditLog;

    bool hasRecentBlockedAttempt =
        latestBlockedAttempt != null &&
        latestBlockedAttempt.CreatedAt >=
            DateTime.Now.AddHours(-24);

    string roleClass =
        role switch
        {
            "Admin" => "role-admin",
            "Staff" => "role-staff",
            "Customer" => "role-customer",
            _ => "role-default"
        };
}

<style>
    .dashboard-page {
        position: relative;
        min-height: calc(100vh - 76px);
        padding: 45px 0 80px;
    }

        .dashboard-page::before {
            position: absolute;
            inset: 0;
            z-index: -3;
            content: "";
            background: radial-gradient( circle at 13% 18%, rgba(0, 229, 255, 0.09), transparent 28%), radial-gradient( circle at 88% 72%, rgba(139, 92, 246, 0.08), transparent 30%);
        }

    .command-header {
        position: relative;
        margin-bottom: 28px;
        padding: 38px;
        overflow: hidden;
        border: 1px solid rgba(148, 163, 184, 0.14);
        border-radius: 22px;
        background: linear-gradient( 125deg, rgba(13, 23, 38, 0.98), rgba(15, 42, 73, 0.92));
        box-shadow: 0 24px 65px rgba(0, 0, 0, 0.3);
    }

        .command-header::before {
            position: absolute;
            inset: 0;
            content: "";
            opacity: 0.16;
            background-image: linear-gradient( rgba(0, 229, 255, 0.13) 1px, transparent 1px), linear-gradient( 90deg, rgba(0, 229, 255, 0.13) 1px, transparent 1px);
            background-size: 43px 43px;
            mask-image: linear-gradient( 90deg, black, transparent);
        }

        .command-header::after {
            position: absolute;
            width: 320px;
            height: 320px;
            top: -190px;
            right: -80px;
            content: "";
            border-radius: 50%;
            background: rgba(0, 229, 255, 0.17);
            filter: blur(60px);
        }

    .command-header-content {
        position: relative;
        z-index: 1;
    }

    .command-eyebrow {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 13px;
        color: #67e8f9;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.15em;
        text-transform: uppercase;
    }

        .command-eyebrow::before {
            width: 8px;
            height: 8px;
            content: "";
            border-radius: 50%;
            background: #00e5ff;
            box-shadow: 0 0 12px #00e5ff;
        }

    .command-title {
        margin-bottom: 10px;
        color: #f8fafc;
        font-size: clamp(2rem, 4vw, 3.45rem);
        font-weight: 800;
        letter-spacing: -0.045em;
    }

    .command-gradient {
        color: transparent;
        background: linear-gradient( 90deg, #00e5ff, #60a5fa, #a78bfa);
        background-clip: text;
        -webkit-background-clip: text;
    }

    .command-description {
        max-width: 650px;
        margin: 0;
        color: #94a3b8;
        line-height: 1.7;
    }

    .command-status-panel {
        display: inline-grid;
        min-width: 220px;
        gap: 12px;
        padding: 17px;
        text-align: left;
        border: 1px solid rgba(148, 163, 184, 0.14);
        border-radius: 13px;
        background: rgba(5, 11, 20, 0.62);
        backdrop-filter: blur(12px);
    }

    .command-status-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
    }

    .command-status-label {
        color: #64748b;
        font-size: 0.67rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .command-status-value {
        color: #dbe7f5;
        font-family: monospace;
        font-size: 0.73rem;
        font-weight: 700;
    }

    .system-online {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: #86efac;
    }

        .system-online::before {
            width: 7px;
            height: 7px;
            content: "";
            border-radius: 50%;
            background: #22c55e;
            box-shadow: 0 0 10px #22c55e;
        }

    .dashboard-role {
        display: inline-flex;
        align-items: center;
        padding: 6px 10px;
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        border: 1px solid;
        border-radius: 7px;
    }

    .role-admin {
        color: #c4b5fd;
        border-color: rgba(167, 139, 250, 0.28);
        background: rgba(139, 92, 246, 0.09);
    }

    .role-staff {
        color: #67e8f9;
        border-color: rgba(0, 229, 255, 0.27);
        background: rgba(0, 229, 255, 0.08);
    }

    .role-customer {
        color: #86efac;
        border-color: rgba(34, 197, 94, 0.27);
        background: rgba(34, 197, 94, 0.08);
    }

    .role-default {
        color: #cbd5e1;
        border-color: rgba(148, 163, 184, 0.25);
        background: rgba(148, 163, 184, 0.08);
    }

    .dashboard-message {
        border-radius: 11px;
    }

    .security-alert {
        margin-bottom: 28px;
        overflow: hidden;
        border: 1px solid rgba(244, 63, 94, 0.32);
        border-radius: 18px;
        background: linear-gradient( 145deg, rgba(48, 13, 27, 0.95), rgba(20, 12, 24, 0.97));
        box-shadow: 0 22px 55px rgba(80, 0, 20, 0.2), 0 0 45px rgba(244, 63, 94, 0.07);
    }

    .security-alert-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        padding: 20px 23px;
        border-bottom: 1px solid rgba(244, 63, 94, 0.2);
        background: rgba(244, 63, 94, 0.08);
    }

    .security-alert-heading {
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .security-alert-icon {
        display: grid;
        width: 42px;
        height: 42px;
        flex: 0 0 42px;
        place-items: center;
        color: #fecdd3;
        font-family: monospace;
        font-size: 0.7rem;
        font-weight: 900;
        border: 1px solid rgba(251, 113, 133, 0.32);
        border-radius: 11px;
        background: rgba(244, 63, 94, 0.12);
    }

    .security-alert-title {
        margin: 0 0 3px;
        color: #ffe4e6;
        font-size: 1rem;
        font-weight: 800;
    }

    .security-alert-subtitle {
        margin: 0;
        color: #c897a3;
        font-size: 0.77rem;
    }

    .security-incident-count {
        padding: 7px 10px;
        color: #fecdd3;
        font-family: monospace;
        font-size: 0.71rem;
        font-weight: 800;
        border: 1px solid rgba(251, 113, 133, 0.26);
        border-radius: 8px;
        background: rgba(244, 63, 94, 0.09);
    }

    .security-alert-body {
        padding: 23px;
    }

    .security-warning {
        margin-bottom: 18px;
        padding: 13px 15px;
        color: #fecdd3;
        font-size: 0.8rem;
        line-height: 1.6;
        border-left: 3px solid #fb7185;
        border-radius: 8px;
        background: rgba(244, 63, 94, 0.06);
    }

    .security-table {
        overflow: hidden;
        margin-bottom: 18px;
        border: 1px solid rgba(251, 113, 133, 0.13);
        border-radius: 10px;
    }

        .security-table .table {
            color: #dbe7f5;
            background: transparent;
        }

            .security-table .table th {
                color: #d6a5af;
                font-size: 0.68rem;
                letter-spacing: 0.06em;
                text-transform: uppercase;
                border-color: rgba(251, 113, 133, 0.12);
                background: rgba(244, 63, 94, 0.06);
            }

            .security-table .table td {
                color: #b8a0a7;
                font-size: 0.76rem;
                border-color: rgba(251, 113, 133, 0.09);
                background: transparent;
            }

        .security-table code {
            color: #fecdd3;
        }

    .security-alert-button {
        display: inline-flex;
        min-height: 43px;
        align-items: center;
        justify-content: center;
        padding: 0 16px;
        color: #ffffff;
        font-size: 0.78rem;
        font-weight: 800;
        text-decoration: none;
        border: 1px solid #fb7185;
        border-radius: 9px;
        background: linear-gradient( 135deg, #e11d48, #be123c);
    }

        .security-alert-button:hover {
            color: #ffffff;
            box-shadow: 0 0 24px rgba(244, 63, 94, 0.24);
        }

    .dashboard-section-header {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 20px;
        margin: 40px 0 22px;
    }

    .dashboard-section-eyebrow {
        margin-bottom: 7px;
        color: #00e5ff;
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.13em;
        text-transform: uppercase;
    }

    .dashboard-section-title {
        margin: 0;
        color: #f8fafc;
        font-size: 1.65rem;
        font-weight: 800;
        letter-spacing: -0.03em;
    }

    .dashboard-section-description {
        max-width: 480px;
        margin: 0;
        color: #718096;
        font-size: 0.8rem;
        text-align: right;
    }

    .workspace-card {
        --card-accent: #00e5ff;
        position: relative;
        display: flex;
        height: 100%;
        min-height: 260px;
        flex-direction: column;
        padding: 25px;
        overflow: hidden;
        border: 1px solid rgba(148, 163, 184, 0.13);
        border-radius: 17px;
        background: linear-gradient( 145deg, rgba(13, 23, 38, 0.94), rgba(7, 14, 25, 0.97));
        box-shadow: 0 17px 42px rgba(0, 0, 0, 0.17);
        transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    }

        .workspace-card::before {
            position: absolute;
            width: 80px;
            height: 2px;
            top: 0;
            left: 25px;
            content: "";
            background: linear-gradient( 90deg, var(--card-accent), transparent);
            box-shadow: 0 0 15px var(--card-accent);
        }

        .workspace-card::after {
            position: absolute;
            width: 130px;
            height: 130px;
            right: -70px;
            bottom: -70px;
            content: "";
            border-radius: 50%;
            background: var(--card-accent);
            opacity: 0.06;
            filter: blur(10px);
        }

        .workspace-card:hover {
            transform: translateY(-6px);
            border-color: color-mix( in srgb, var(--card-accent) 35%, transparent);
            box-shadow: 0 24px 55px rgba(0, 0, 0, 0.27);
        }

    .workspace-users {
        --card-accent: #a78bfa;
    }

    .workspace-customers {
        --card-accent: #00e5ff;
    }

    .workspace-repairs {
        --card-accent: #22c55e;
    }

    .workspace-inventory {
        --card-accent: #facc15;
    }

    .workspace-invoices {
        --card-accent: #60a5fa;
    }

    .workspace-face {
        --card-accent: #fb7185;
    }

    .workspace-tracking {
        --card-accent: #38bdf8;
    }

    .workspace-card-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        margin-bottom: 23px;
    }

    .workspace-icon {
        display: grid;
        width: 50px;
        height: 50px;
        place-items: center;
        color: var(--card-accent);
        font-family: monospace;
        font-size: 0.71rem;
        font-weight: 900;
        border: 1px solid color-mix( in srgb, var(--card-accent) 30%, transparent);
        border-radius: 13px;
        background: color-mix( in srgb, var(--card-accent) 8%, transparent);
    }

    .workspace-access {
        color: #64748b;
        font-size: 0.62rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .workspace-card h3 {
        margin-bottom: 10px;
        color: #f8fafc;
        font-size: 1.08rem;
        font-weight: 800;
    }

    .workspace-card p {
        margin-bottom: 22px;
        color: #8291a7;
        font-size: 0.82rem;
        line-height: 1.65;
    }

    .workspace-button {
        position: relative;
        z-index: 2;
        display: flex;
        min-height: 43px;
        align-items: center;
        justify-content: space-between;
        margin-top: auto;
        padding: 0 14px;
        color: #dbe7f5;
        font-size: 0.76rem;
        font-weight: 800;
        text-decoration: none;
        border: 1px solid rgba(148, 163, 184, 0.17);
        border-radius: 9px;
        background: rgba(15, 23, 42, 0.62);
    }

        .workspace-button:hover {
            color: var(--card-accent);
            border-color: color-mix( in srgb, var(--card-accent) 32%, transparent);
            background: color-mix( in srgb, var(--card-accent) 5%, transparent);
        }

    .admin-security-panel {
        position: relative;
        margin-top: 28px;
        padding: 29px;
        overflow: hidden;
        border: 1px solid rgba(167, 139, 250, 0.17);
        border-radius: 18px;
        background: linear-gradient( 125deg, rgba(21, 17, 42, 0.93), rgba(11, 20, 35, 0.96));
    }

        .admin-security-panel::after {
            position: absolute;
            width: 230px;
            height: 230px;
            top: -130px;
            right: -80px;
            content: "";
            border-radius: 50%;
            background: rgba(139, 92, 246, 0.14);
            filter: blur(50px);
        }

    .admin-security-content {
        position: relative;
        z-index: 1;
    }

    .admin-security-label {
        margin-bottom: 8px;
        color: #c4b5fd;
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .admin-security-title {
        margin-bottom: 8px;
        color: #f8fafc;
        font-size: 1.3rem;
        font-weight: 800;
    }

    .admin-security-description {
        max-width: 680px;
        margin: 0;
        color: #8f8ba7;
        font-size: 0.82rem;
        line-height: 1.65;
    }

    .admin-security-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }

    .admin-security-button {
        display: inline-flex;
        min-height: 42px;
        align-items: center;
        justify-content: center;
        padding: 0 15px;
        color: #e9d5ff;
        font-size: 0.75rem;
        font-weight: 800;
        text-decoration: none;
        border: 1px solid rgba(167, 139, 250, 0.27);
        border-radius: 9px;
        background: rgba(139, 92, 246, 0.09);
    }

        .admin-security-button:hover {
            color: #ffffff;
            border-color: rgba(196, 181, 253, 0.5);
            background: rgba(139, 92, 246, 0.15);
        }

    @@media (max-width: 991px) {
        .command-status-panel {
            width: 100%;
            margin-top: 28px;
        }

        .dashboard-section-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .dashboard-section-description {
            text-align: left;
        }

        .admin-security-actions {
            justify-content: flex-start;
            margin-top: 20px;
        }
    }

    @@media (max-width: 767px) {
        .dashboard-page {
            padding: 28px 0 60px;
        }

        .command-header {
            padding: 28px 23px;
        }

        .command-title {
            font-size: 2.25rem;
        }

        .security-alert-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .security-table {
            overflow-x: auto;
        }

        .workspace-card {
            min-height: 235px;
        }

        .admin-security-panel {
            padding: 23px;
        }

        .admin-security-actions {
            display: grid;
        }

        .admin-security-button {
            width: 100%;
        }
    }
</style>

<section class="dashboard-page">

    <div class="container">

        <!-- COMMAND HEADER -->
        <header class="command-header">

            <div class="command-header-content">

                <div class="row align-items-center">

                    <div class="col-lg-8">

                        <div class="command-eyebrow">
                            Secure OKCS Command Centre
                        </div>

                        <h1 class="command-title">

                            Welcome,

                            <span class="command-gradient">
                                @fullName
                            </span>

                        </h1>

                        <p class="command-description">

                            Access your authorised tools,
                            monitor repair operations and
                            manage daily activities through
                            one secure workspace.

                        </p>

                    </div>

                    <div class="col-lg-4 text-lg-end">

                        <div class="command-status-panel">

                            <div class="command-status-row">

                                <span class="command-status-label">
                                    System
                                </span>

                                <span class="command-status-value
                                    system-online">
                                    Online
                                </span>

                            </div>

                            <div class="command-status-row">

                                <span class="command-status-label">
                                    Access Role
                                </span>

                                <span class="dashboard-role
                                    @roleClass">
                                    @role
                                </span>

                            </div>

                            <div class="command-status-row">

                                <span class="command-status-label">
                                    Date
                                </span>

                                <span class="command-status-value">

                                    @(DateTime.Now.ToString(
                                        "dd MMM yyyy"))

                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </header>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success
                alert-dismissible fade show
                dashboard-message">

                @TempData["Success"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>

            </div>
        }

        @if (TempData["Info"] != null)
        {
            <div class="alert alert-info
                alert-dismissible fade show
                dashboard-message">

                @TempData["Info"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>

            </div>
        }

        <!-- ADMIN INTRUSION ALERT -->
        @if (role == "Admin" &&
            (intrusionCount > 0 ||
             hasRecentBlockedAttempt))
        {
            <section class="security-alert">

                <div class="security-alert-header">

                    <div class="security-alert-heading">

                        <div class="security-alert-icon">
                            ALERT
                        </div>

                        <div>

                            <h2 class="security-alert-title">
                                Security intrusion detected
                            </h2>

                            <p class="security-alert-subtitle">

                                Suspicious Face ID login activity
                                was detected during the last
                                24 hours.

                            </p>

                        </div>

                    </div>

                    <div class="security-incident-count">

                        @intrusionCount incident(s)

                    </div>

                </div>

                <div class="security-alert-body">

                    @if (intrusionCount > 0)
                    {
                        <div class="security-warning">

                            <strong>
                                Security warning:
                            </strong>

                            Face verification failed repeatedly.
                            The related user and IP combination
                            was temporarily blocked for five
                            minutes.

                        </div>
                    }

                    @if (intrusionAlerts.Any())
                    {
                        <div class="security-table">

                            <div class="table-responsive">

                                <table class="table mb-0">

                                    <thead>

                                        <tr>
                                            <th>Date and Time</th>
                                            <th>Target User</th>
                                            <th>IP Address</th>
                                            <th>Details</th>
                                        </tr>

                                    </thead>

                                    <tbody>

                                        @foreach (var alert
                                            in intrusionAlerts)
                                        {
                                            <tr>

                                                <td>

                                                    @(alert.CreatedAt
                                                        .ToString(
                                                            "dd MMM yyyy, hh:mm:ss tt"))

                                                </td>

                                                <td>

                                                    @(alert.RecordId
                                                        ?? "-")

                                                </td>

                                                <td>

                                                    <code>

                                                        @(alert.IpAddress
                                                            ?? "Unknown")

                                                    </code>

                                                </td>

                                                <td>

                                                    @(alert.ActionDetails
                                                        ?? "Face verification failed.")

                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>

                        </div>
                    }

                    @if (hasRecentBlockedAttempt)
                    {
                        <div class="security-warning">

                            <strong>
                                Blocked lockout attempt:
                            </strong>

                            IP address

                            <code class="text-light">

                                @(latestBlockedAttempt!
                                    .IpAddress
                                    ?? "Unknown")

                            </code>

                            attempted to access the account at

                            <strong>

                                @(latestBlockedAttempt!
                                    .CreatedAt
                                    .ToString(
                                        "dd MMM yyyy, hh:mm:ss tt"))

                            </strong>.

                        </div>
                    }

                    <a asp-controller="AuditLogs"
                       asp-action="Index"
                       class="security-alert-button">

                        Investigate Audit Logs →

                    </a>

                </div>

            </section>
        }

        <!-- WORKSPACE HEADER -->
        <div class="dashboard-section-header">

            <div>

                <div class="dashboard-section-eyebrow">
                    Authorised Workspace
                </div>

                <h2 class="dashboard-section-title">
                    Quick access
                </h2>

            </div>

            <p class="dashboard-section-description">

                Only modules authorised for your
                account role are displayed below.

            </p>

        </div>

        <div class="row g-4">

            @if (role == "Admin")
            {
                <!-- USER MANAGEMENT -->
                <div class="col-md-6 col-xl-4">

                    <article class="workspace-card
                        workspace-users">

                        <div class="workspace-card-header">

                            <div class="workspace-icon">
                                USR
                            </div>

                            <div class="workspace-access">
                                Admin Only
                            </div>

                        </div>

                        <h3>User Management</h3>

                        <p>
                            Create and manage staff accounts,
                            roles and authorised system users.
                        </p>

                        <a asp-controller="Users"
                           asp-action="Index"
                           class="workspace-button">

                            Manage Users
                            <span>→</span>

                        </a>

                    </article>

                </div>
            }

            @if (role == "Admin" ||
                role == "Staff")
            {
                <!-- CUSTOMER MANAGEMENT -->
                <div class="col-md-6 col-xl-4">

                    <article class="workspace-card
                        workspace-customers">

                        <div class="workspace-card-header">

                            <div class="workspace-icon">
                                CST
                            </div>

                            <div class="workspace-access">
                                Operations
                            </div>

                        </div>

                        <h3>Customer Management</h3>

                        <p>
                            Register customers and manage
                            protected customer information.
                        </p>

                        <a asp-controller="Customers"
                           asp-action="Index"
                           class="workspace-button">

                            Open Customers
                            <span>→</span>

                        </a>

                    </article>

                </div>

                <!-- REPAIR MANAGEMENT -->
                <div class="col-md-6 col-xl-4">

                    <article class="workspace-card
                        workspace-repairs">

                        <div class="workspace-card-header">

                            <div class="workspace-icon">
                                RPR
                            </div>

                            <div class="workspace-access">
                                Operations
                            </div>

                        </div>

                        <h3>Repair Management</h3>

                        <p>
                            Create repair tickets, assign
                            technicians and update repair
                            progress.
                        </p>

                        <a asp-controller="Repairs"
                           asp-action="Index"
                           class="workspace-button">

                            Open Repairs
                            <span>→</span>

                        </a>

                    </article>

                </div>

                <!-- INVENTORY -->
                <div class="col-md-6 col-xl-4">

                    <article class="workspace-card
                        workspace-inventory">

                        <div class="workspace-card-header">

                            <div class="workspace-icon">
                                INV
                            </div>

                            <div class="workspace-access">
                                Stock Control
                            </div>

                        </div>

                        <h3>Inventory Management</h3>

                        <p>
                            Manage spare parts, barcode
                            scanning, stock levels and
                            movement reports.
                        </p>

                        <a asp-controller="Inventory"
                           asp-action="Index"
                           class="workspace-button">

                            Open Inventory
                            <span>→</span>

                        </a>

                    </article>

                </div>

                <!-- INVOICES -->
                <div class="col-md-6 col-xl-4">

                    <article class="workspace-card
                        workspace-invoices">

                        <div class="workspace-card-header">

                            <div class="workspace-icon">
                                PAY
                            </div>

                            <div class="workspace-access">
                                Finance
                            </div>

                        </div>

                        <h3>Invoice Management</h3>

                        <p>
                            View invoices, record customer
                            payments and print invoice
                            documents.
                        </p>

                        <a asp-controller="Invoices"
                           asp-action="Index"
                           class="workspace-button">

                            Open Invoices
                            <span>→</span>

                        </a>

                    </article>

                </div>

                <!-- FACE ID -->
                <div class="col-md-6 col-xl-4">

                    <article class="workspace-card
                        workspace-face">

                        <div class="workspace-card-header">

                            <div class="workspace-icon">
                                BIO
                            </div>

                            <div class="workspace-access">
                                Security
                            </div>

                        </div>

                        <h3>Face ID Management</h3>

                        <p>
                            Enrol or update the Face ID
                            registered to your protected
                            account.
                        </p>

                        <a asp-controller="Face"
                           asp-action="Enroll"
                           class="workspace-button">

                            Manage Face ID
                            <span>→</span>

                        </a>

                    </article>

                </div>
            }

            @if (role == "Customer")
            {
                <!-- CUSTOMER TRACKING -->
                <div class="col-md-6 col-xl-4">

                    <article class="workspace-card
                        workspace-tracking">

                        <div class="workspace-card-header">

                            <div class="workspace-icon">
                                TRK
                            </div>

                            <div class="workspace-access">
                                Customer
                            </div>

                        </div>

                        <h3>Track Your Repair</h3>

                        <p>
                            View the current status and
                            progress history of your device
                            repair.
                        </p>

                        <a asp-controller="Tracking"
                           asp-action="Index"
                           class="workspace-button">

                            Track Repair
                            <span>→</span>

                        </a>

                    </article>

                </div>
            }

        </div>

        @if (role == "Admin")
        {
            <!-- ADMIN SECURITY CENTRE -->
            <section class="admin-security-panel">

                <div class="admin-security-content">

                    <div class="row align-items-center">

                        <div class="col-lg-7">

                            <div class="admin-security-label">
                                Administration and Security
                            </div>

                            <h2 class="admin-security-title">
                                Security monitoring centre
                            </h2>

                            <p class="admin-security-description">

                                Review user activity, system
                                changes, authentication events
                                and potential intrusion attempts
                                recorded by Secure OKCS.

                            </p>

                        </div>

                        <div class="col-lg-5">

                            <div class="admin-security-actions">

                                <a asp-controller="AuditLogs"
                                   asp-action="Index"
                                   class="admin-security-button">

                                    Open Audit Logs

                                </a>

                                <a asp-controller="Users"
                                   asp-action="Index"
                                   class="admin-security-button">

                                    Manage Users

                                </a>

                            </div>

                        </div>

                    </div>

                </div>

            </section>
        }

    </div>

</section>