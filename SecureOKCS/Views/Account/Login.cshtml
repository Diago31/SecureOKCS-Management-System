@model SecureOKCS.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Sign In";
}

<style>
    .auth-page {
        position: relative;
        display: flex;
        min-height: calc(100vh - 76px);
        align-items: center;
        padding: 65px 0;
        overflow: hidden;
    }

        .auth-page::before {
            position: absolute;
            inset: 0;
            z-index: -3;
            content: "";
            background: radial-gradient( circle at 15% 20%, rgba(0, 229, 255, 0.14), transparent 31%), radial-gradient( circle at 85% 75%, rgba(139, 92, 246, 0.13), transparent 32%), #050b14;
        }

    .auth-grid {
        position: absolute;
        inset: 0;
        z-index: -2;
        opacity: 0.18;
        background-image: linear-gradient( rgba(0, 229, 255, 0.12) 1px, transparent 1px), linear-gradient( 90deg, rgba(0, 229, 255, 0.12) 1px, transparent 1px);
        background-size: 50px 50px;
        mask-image: linear-gradient( to bottom, black, transparent);
    }

    .auth-shell {
        overflow: hidden;
        border: 1px solid rgba(148, 163, 184, 0.15);
        border-radius: 24px;
        background: rgba(9, 17, 30, 0.94);
        box-shadow: 0 35px 90px rgba(0, 0, 0, 0.48), 0 0 70px rgba(0, 229, 255, 0.06);
        backdrop-filter: blur(18px);
    }

    .auth-information {
        position: relative;
        display: flex;
        min-height: 650px;
        flex-direction: column;
        justify-content: space-between;
        padding: 55px;
        overflow: hidden;
        border-right: 1px solid rgba(148, 163, 184, 0.12);
        background: linear-gradient( 145deg, rgba(13, 23, 38, 0.96), rgba(12, 31, 55, 0.92));
    }

        .auth-information::before {
            position: absolute;
            width: 330px;
            height: 330px;
            right: -160px;
            bottom: -150px;
            content: "";
            border-radius: 50%;
            background: rgba(0, 229, 255, 0.18);
            filter: blur(65px);
        }

        .auth-information::after {
            position: absolute;
            width: 250px;
            height: 250px;
            top: -130px;
            left: -120px;
            content: "";
            border-radius: 50%;
            background: rgba(139, 92, 246, 0.15);
            filter: blur(65px);
        }

    .auth-info-content {
        position: relative;
        z-index: 1;
    }

    .auth-brand {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        color: #f8fafc;
        font-size: 1.05rem;
        font-weight: 800;
        text-decoration: none;
    }

        .auth-brand:hover {
            color: #ffffff;
        }

    .auth-brand-mark {
        display: grid;
        width: 42px;
        height: 42px;
        place-items: center;
        color: #031019;
        font-weight: 900;
        border-radius: 12px;
        background: linear-gradient( 135deg, #00e5ff, #60a5fa);
        box-shadow: 0 0 24px rgba(0, 229, 255, 0.23);
    }

    .auth-eyebrow {
        margin: 85px 0 16px;
        color: #67e8f9;
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 0.15em;
        text-transform: uppercase;
    }

    .auth-information h1 {
        max-width: 520px;
        margin-bottom: 20px;
        color: #f8fafc;
        font-size: clamp(2.35rem, 4vw, 3.6rem);
        font-weight: 800;
        line-height: 1.08;
        letter-spacing: -0.045em;
    }

    .auth-gradient {
        color: transparent;
        background: linear-gradient( 90deg, #00e5ff, #60a5fa, #a78bfa);
        background-clip: text;
        -webkit-background-clip: text;
    }

    .auth-description {
        max-width: 500px;
        color: #94a3b8;
        font-size: 0.96rem;
        line-height: 1.8;
    }

    .auth-security-list {
        position: relative;
        z-index: 1;
        display: grid;
        gap: 13px;
        margin-top: 40px;
    }

    .auth-security-item {
        display: flex;
        align-items: center;
        gap: 11px;
        color: #b8c4d5;
        font-size: 0.86rem;
    }

    .auth-check {
        display: grid;
        width: 23px;
        height: 23px;
        flex: 0 0 23px;
        place-items: center;
        color: #00e5ff;
        font-size: 0.7rem;
        font-weight: 900;
        border: 1px solid rgba(0, 229, 255, 0.3);
        border-radius: 50%;
        background: rgba(0, 229, 255, 0.07);
    }

    .auth-system-state {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 10px;
        color: #7dd3fc;
        font-family: monospace;
        font-size: 0.73rem;
        letter-spacing: 0.07em;
        text-transform: uppercase;
    }

    .auth-state-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #22c55e;
        box-shadow: 0 0 13px #22c55e;
    }

    .auth-form-area {
        display: flex;
        min-height: 650px;
        align-items: center;
        padding: 48px;
        background: linear-gradient( 145deg, rgba(7, 14, 25, 0.98), rgba(5, 11, 20, 0.98));
    }

    .auth-form-container {
        width: 100%;
        max-width: 430px;
        margin: auto;
    }

    .auth-mobile-brand {
        display: none;
        margin-bottom: 32px;
    }

    .auth-form-eyebrow {
        margin-bottom: 10px;
        color: #00e5ff;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.14em;
        text-transform: uppercase;
    }

    .auth-form-title {
        margin-bottom: 10px;
        color: #f8fafc;
        font-size: 2rem;
        font-weight: 800;
        letter-spacing: -0.035em;
    }

    .auth-form-subtitle {
        margin-bottom: 30px;
        color: #8291a7;
        font-size: 0.9rem;
        line-height: 1.65;
    }

    .auth-success {
        margin-bottom: 22px;
        padding: 13px 15px;
        color: #a7f3d0;
        font-size: 0.85rem;
        border: 1px solid rgba(34, 197, 94, 0.25);
        border-radius: 10px;
        background: rgba(34, 197, 94, 0.08);
    }

    .auth-validation {
        margin-bottom: 20px;
        padding: 13px 15px;
        color: #fecaca;
        font-size: 0.84rem;
        border: 1px solid rgba(239, 68, 68, 0.28);
        border-radius: 10px;
        background: rgba(239, 68, 68, 0.08);
    }

        .auth-validation:empty,
        .auth-validation.validation-summary-valid {
            display: none;
        }

        .auth-validation ul {
            margin: 0;
            padding-left: 18px;
        }

    .auth-field {
        margin-bottom: 20px;
    }

    .auth-label {
        margin-bottom: 8px;
        color: #dbe7f5;
        font-size: 0.85rem;
        font-weight: 700;
    }

    .auth-input {
        min-height: 51px;
        color: #f8fafc !important;
        border: 1px solid #263449;
        border-radius: 10px;
        background: rgba(15, 23, 42, 0.75) !important;
    }

        .auth-input::placeholder {
            color: #64748b;
        }

        .auth-input:focus {
            color: #ffffff;
            border-color: #00e5ff;
            background: rgba(15, 23, 42, 0.95);
            box-shadow: 0 0 0 0.2rem rgba(0, 229, 255, 0.11);
        }

    .password-field {
        position: relative;
    }

        .password-field .auth-input {
            padding-right: 76px;
        }

    .password-toggle {
        position: absolute;
        top: 50%;
        right: 9px;
        padding: 6px 9px;
        color: #7dd3fc;
        font-size: 0.72rem;
        font-weight: 700;
        border: 0;
        border-radius: 7px;
        background: transparent;
        transform: translateY(-50%);
    }

        .password-toggle:hover {
            color: #ffffff;
            background: rgba(0, 229, 255, 0.08);
        }

    .auth-field-error {
        display: block;
        margin-top: 6px;
        font-size: 0.78rem;
    }

    .auth-options {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin: 5px 0 24px;
    }

    .auth-remember-label {
        color: #9aa9bc;
        font-size: 0.84rem;
    }

    .auth-page .form-check-input {
        border-color: #475569;
        background-color: #0f172a;
    }

        .auth-page .form-check-input:checked {
            border-color: #00e5ff;
            background-color: #00bcd4;
        }

    .auth-submit {
        width: 100%;
        min-height: 52px;
        color: #031019;
        font-weight: 800;
        border: 1px solid #00e5ff;
        border-radius: 10px;
        background: linear-gradient( 135deg, #00e5ff, #60a5fa);
        box-shadow: 0 0 27px rgba(0, 229, 255, 0.17);
    }

        .auth-submit:hover {
            color: #031019;
            border-color: #67e8f9;
            box-shadow: 0 0 36px rgba(0, 229, 255, 0.29);
        }

    .auth-face-notice {
        display: grid;
        grid-template-columns: 38px 1fr;
        gap: 12px;
        margin-top: 22px;
        padding: 14px;
        border: 1px solid rgba(139, 92, 246, 0.22);
        border-radius: 11px;
        background: rgba(139, 92, 246, 0.07);
    }

    .auth-face-icon {
        display: grid;
        width: 38px;
        height: 38px;
        place-items: center;
        color: #c4b5fd;
        font-family: monospace;
        font-size: 0.66rem;
        font-weight: 900;
        border: 1px solid rgba(167, 139, 250, 0.25);
        border-radius: 9px;
    }

    .auth-face-notice strong {
        display: block;
        margin-bottom: 3px;
        color: #ddd6fe;
        font-size: 0.82rem;
    }

    .auth-face-notice p {
        margin: 0;
        color: #9389ac;
        font-size: 0.75rem;
        line-height: 1.5;
    }

    .auth-divider {
        display: flex;
        align-items: center;
        gap: 14px;
        margin: 25px 0;
        color: #58677d;
        font-size: 0.72rem;
        text-transform: uppercase;
    }

        .auth-divider::before,
        .auth-divider::after {
            height: 1px;
            flex: 1;
            content: "";
            background: rgba(148, 163, 184, 0.14);
        }

    .auth-register-link {
        display: block;
        width: 100%;
        padding: 12px;
        color: #dbe7f5;
        font-size: 0.86rem;
        font-weight: 700;
        text-align: center;
        text-decoration: none;
        border: 1px solid rgba(148, 163, 184, 0.22);
        border-radius: 10px;
        background: rgba(15, 23, 42, 0.55);
    }

        .auth-register-link:hover {
            color: #67e8f9;
            border-color: rgba(0, 229, 255, 0.35);
            background: rgba(0, 229, 255, 0.05);
        }

    .auth-home-link {
        display: block;
        margin-top: 22px;
        color: #64748b;
        font-size: 0.78rem;
        text-align: center;
        text-decoration: none;
    }

        .auth-home-link:hover {
            color: #7dd3fc;
        }

    @@media (max-width: 991px) {
        .auth-page {
            padding: 45px 0;
        }

        .auth-information {
            display: none;
        }

        .auth-form-area {
            min-height: auto;
            padding: 45px;
        }

        .auth-mobile-brand {
            display: inline-flex;
        }
    }

    @@media (max-width: 576px) {
        .auth-page {
            align-items: flex-start;
            padding: 25px 0;
        }

        .auth-shell {
            border-radius: 17px;
        }

        .auth-form-area {
            padding: 31px 22px;
        }

        .auth-form-title {
            font-size: 1.75rem;
        }
    }
</style>

<section class="auth-page">

    <div class="auth-grid"
         aria-hidden="true">
    </div>

    <div class="container">

        <div class="auth-shell">

            <div class="row g-0">

                <!-- SECURITY INFORMATION -->
                <div class="col-lg-7">

                    <div class="auth-information">

                        <div class="auth-info-content">

                            <a asp-controller="Home"
                               asp-action="Index"
                               class="auth-brand">

                                <span class="auth-brand-mark">
                                    S
                                </span>

                                <span>
                                    Secure OKCS
                                </span>

                            </a>

                            <div class="auth-eyebrow">
                                Protected System Access
                            </div>

                            <h1>
                                Sign in securely.

                                <span class="auth-gradient">
                                    Manage with confidence.
                                </span>
                            </h1>

                            <p class="auth-description">

                                Access repair operations, customer
                                records and system management through
                                a protected role-based environment.

                            </p>

                            <div class="auth-security-list">

                                <div class="auth-security-item">

                                    <span class="auth-check">
                                        ✓
                                    </span>

                                    Secure password verification

                                </div>

                                <div class="auth-security-item">

                                    <span class="auth-check">
                                        ✓
                                    </span>

                                    Face ID verification for
                                    protected accounts

                                </div>

                                <div class="auth-security-item">

                                    <span class="auth-check">
                                        ✓
                                    </span>

                                    Suspicious login monitoring
                                    and temporary lockout

                                </div>

                            </div>

                        </div>

                        <div class="auth-system-state">

                            <span class="auth-state-dot"></span>

                            Authentication services online

                        </div>

                    </div>

                </div>

                <!-- LOGIN FORM -->
                <div class="col-lg-5">

                    <div class="auth-form-area">

                        <div class="auth-form-container">

                            <a asp-controller="Home"
                               asp-action="Index"
                               class="auth-brand
                                auth-mobile-brand">

                                <span class="auth-brand-mark">
                                    S
                                </span>

                                <span>
                                    Secure OKCS
                                </span>

                            </a>

                            <div class="auth-form-eyebrow">
                                Account Authentication
                            </div>

                            <h2 class="auth-form-title">
                                Welcome back
                            </h2>

                            <p class="auth-form-subtitle">

                                Enter your registered email and
                                password to continue.

                            </p>

                            @if (TempData["Success"] != null)
                            {
                                <div class="auth-success"
                                     role="alert">

                                    @TempData["Success"]

                                </div>
                            }

                            @if (TempData["Info"] != null)
                            {
                                <div class="alert alert-info"
                                     role="alert">

                                    @TempData["Info"]

                                </div>
                            }

                            <form asp-controller="Account"
                                  asp-action="Login"
                                  method="post">

                                <div asp-validation-summary="ModelOnly"
                                     class="auth-validation"
                                     role="alert">
                                </div>

                                <div class="auth-field">

                                    <label asp-for="Email"
                                           class="auth-label">

                                        Email Address

                                    </label>

                                    <input asp-for="Email"
                                           type="email"
                                           class="form-control
                                    auth-input"
                                           placeholder="name@example.com"
                                           autocomplete="email"
                                           autofocus />

                                    <span asp-validation-for="Email"
                                          class="text-danger
                                        auth-field-error">
                                    </span>

                                </div>

                                <div class="auth-field">

                                    <label asp-for="Password"
                                           class="auth-label">

                                        Password

                                    </label>

                                    <div class="password-field">

                                        <input asp-for="Password"
                                               class="form-control
                                        auth-input"
                                               placeholder="Enter your password"
                                               autocomplete="current-password"
                                               id="loginPassword" />

                                        <button type="button"
                                                class="password-toggle"
                                                id="passwordToggle"
                                                aria-controls="loginPassword"
                                                aria-label="Show password">

                                            Show

                                        </button>

                                    </div>

                                    <span asp-validation-for="Password"
                                          class="text-danger
                                        auth-field-error">
                                    </span>

                                </div>

                                <div class="auth-options">

                                    <div class="form-check">

                                        <input asp-for="RememberMe"
                                               class="form-check-input" />

                                        <label asp-for="RememberMe"
                                               class="form-check-label
                                            auth-remember-label">

                                            Remember this device

                                        </label>

                                    </div>

                                </div>

                                <button type="submit"
                                        class="btn auth-submit">

                                    Secure Sign In
                                    <span class="ms-1"
                                          aria-hidden="true">
                                        →
                                    </span>

                                </button>

                            </form>

                            <div class="auth-face-notice">

                                <div class="auth-face-icon">
                                    FACE
                                </div>

                                <div>

                                    <strong>
                                        Additional Face ID Security
                                    </strong>

                                    <p>
                                        Face ID verification will
                                        start automatically after
                                        password verification for
                                        protected accounts.
                                    </p>

                                </div>

                            </div>

                            <div class="auth-divider">
                                New customer
                            </div>

                            <a asp-controller="Account"
                               asp-action="Register"
                               class="auth-register-link">

                                Create a Customer Account

                            </a>

                            <a asp-controller="Home"
                               asp-action="Index"
                               class="auth-home-link">

                                ← Return to homepage

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        (() => {
            const passwordInput =
                document.getElementById(
                    "loginPassword");

            const passwordToggle =
                document.getElementById(
                    "passwordToggle");

            if (!passwordInput ||
                !passwordToggle) {
                return;
            }

            passwordToggle.addEventListener(
                "click",
                () => {
                    const isHidden =
                        passwordInput.type ===
                        "password";

                    passwordInput.type =
                        isHidden
                            ? "text"
                            : "password";

                    passwordToggle.textContent =
                        isHidden
                            ? "Hide"
                            : "Show";

                    passwordToggle.setAttribute(
                        "aria-label",
                        isHidden
                            ? "Hide password"
                            : "Show password");
                });
        })();
    </script>
}