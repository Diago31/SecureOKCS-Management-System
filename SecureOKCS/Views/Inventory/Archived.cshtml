@model IEnumerable<SecureOKCS.Models.InventoryItem>

@{
    ViewData["Title"] = "Archived Inventory";
}

<!-- PAGE HEADER -->
<div class="d-md-flex
    justify-content-between
    align-items-center mb-4">

    <div>

        <h1 class="fw-bold mb-1">
            Archived Inventory
        </h1>

        <p class="text-muted mb-md-0">
            View and restore deactivated
            inventory items.
        </p>

    </div>

    <a asp-controller="Inventory"
       asp-action="Index"
       class="btn btn-secondary
        mt-3 mt-md-0">

        Back to Inventory

    </a>

</div>

<!-- SUCCESS MESSAGE -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success
        alert-dismissible fade show">

        @TempData["Success"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}

<!-- SEARCH -->
<div class="card border-0
    shadow-sm mb-4">

    <div class="card-body">

        <form asp-controller="Inventory"
              asp-action="Archived"
              method="get">

            <div class="row g-2">

                <div class="col-md-8">

                    <input type="text"
                           name="search"
                           value="@ViewBag.Search"
                           class="form-control"
                           placeholder="Search item code, name or barcode" />

                </div>

                <div class="col-md-2 d-grid">

                    <button type="submit"
                            class="btn btn-primary">

                        Search

                    </button>

                </div>

                <div class="col-md-2 d-grid">

                    <a asp-controller="Inventory"
                       asp-action="Archived"
                       class="btn btn-outline-secondary">

                        Reset

                    </a>

                </div>

            </div>

        </form>

    </div>

</div>

<!-- ARCHIVED ITEMS TABLE -->
<div class="card border-0 shadow-sm">

    <div class="card-header
        bg-dark text-white">

        <div class="d-flex
            justify-content-between
            align-items-center">

            <h5 class="mb-0">
                Deactivated Items
            </h5>

            <span class="badge bg-light
                text-dark">

                @Model.Count() item(s)

            </span>

        </div>

    </div>

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table
                table-hover mb-0">

                <thead class="table-light">

                    <tr>
                        <th>Item Code</th>
                        <th>Item Name</th>
                        <th>Category</th>
                        <th>Barcode</th>
                        <th>Quantity</th>
                        <th>Unit Price</th>
                        <th>Deactivated Date</th>

                        <th class="text-center">
                            Action
                        </th>
                    </tr>

                </thead>

                <tbody>

                    @if (!Model.Any())
                    {
                        <tr>

                            <td colspan="8"
                                class="text-center
                                text-muted py-5">

                                No archived inventory
                                item found.

                            </td>

                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>

                                <td class="fw-semibold">
                                    @item.ItemCode
                                </td>

                                <td>
                                    @item.ItemName
                                </td>

                                <td>
                                    @(item.Category ?? "-")
                                </td>

                                <td>

                                    @if (string.IsNullOrWhiteSpace(
                                        item.Barcode))
                                    {
                                        <span>-</span>
                                    }
                                    else
                                    {
                                        <code>
                                            @item.Barcode
                                        </code>
                                    }

                                </td>

                                <td>
                                    @item.Quantity
                                </td>

                                <td>
                                    RM
                                    @(item.UnitPrice.ToString(
                                        "N2"))
                                </td>

                                <td>
                                    @(item.UpdatedAt.ToString(
                                        "dd MMM yyyy hh:mm tt"))
                                </td>

                                <td class="text-center">

                                    <form asp-controller="Inventory"
                                          asp-action="Restore"
                                          method="post"
                                          asp-antiforgery="true"
                                          class="d-inline"
                                          onsubmit="return confirm('Restore this inventory item?');">

                                        <input type="hidden"
                                               name="id"
                                               value="@item.InventoryId" />

                                        <button type="submit"
                                                class="btn btn-sm
                                            btn-success">

                                            Restore

                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>